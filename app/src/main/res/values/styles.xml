<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="nav_bar_bn">
        <item name="contentDescription"></item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="h1">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">35dp</item>
    </style>

    <style name="h2">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">25dp</item>
        <item name="fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="h3">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">20dp</item>
        <item name="fontFamily">@font/montserrat_semi_bold</item>
    </style>
    <style name="NavigationViewStyle" >
        <item name="itemIconTint">@color/nav_menu_selector</item>
        <item name="itemTextColor">@color/nav_menu_selector</item>
        <item name="itemBackground">@drawable/nav_menu_item_background</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="itemShapeAppearanceOverlay">@style/NavigationViewItemShape</item>
        <item name="backgroundColor">@null</item>
    </style>

    <style name="NavigationViewItemShape">
        <item name="shapeAppearance">@style/NavigationViewItemCornerSize</item>
    </style>

    <style name="NavigationViewItemCornerSize">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="pages">
        <item name="layout_editor_absoluteX">1dp</item>
        <item name="layout_editor_absoluteY">137dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="background">@drawable/shape_module</item>
    </style>

    <style name="module">
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="background">@drawable/shape_module</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="moduleBn">
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">start</item>
        <item name="fontFamily">@font/montserrat_semi_bold</item>
        <item name="android:textSize">15dp</item>
        <item name="android:padding">15dp</item>
    </style>
</resources>