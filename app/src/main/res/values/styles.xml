<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="nav_bar_bn">
        <item name="contentDescription"></item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="h1">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">35dp</item>
    </style>

    <style name="h2">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">25dp</item>
        <item name="fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="h3">
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">20dp</item>
        <item name="fontFamily">@font/montserrat_semi_bold</item>
    </style>
    <style name="NavigationViewStyle" >
        <item name="itemIconTint">@color/nav_menu_selector</item>
        <item name="itemTextColor">@color/nav_menu_selector</item>
        <item name="itemBackground">@drawable/nav_menu_item_background</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="itemShapeAppearanceOverlay">@style/NavigationViewItemShape</item>
        <item name="backgroundColor">@null</item>
    </style>

    <style name="NavigationViewItemShape">
        <item name="shapeAppearance">@style/NavigationViewItemCornerSize</item>
    </style>

    <style name="NavigationViewItemCornerSize">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="pages">
        <item name="layout_editor_absoluteX">1dp</item>
        <item name="layout_editor_absoluteY">137dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="background">@drawable/shape_module</item>
    </style>

    <style name="module">
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="background">@drawable/shape_module</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="debt">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/montserrat_semi_bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="moduleBn">
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">start</item>
        <item name="fontFamily">@font/montserrat_semi_bold</item>
        <item name="android:textSize">18dp</item>
        <item name="android:padding">12dp</item>

    </style>

    <style name="dang_text">
        <item name="android:textColor">@color/danger</item>
        <item name="fontFamily">@font/montserrat_regular</item>
        <item name="android:paddingVertical">10dp</item>
    </style>

    <style name="deadlineItem">
        <item name="android:textSize">18dp</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="deadlineButton">
        <item name="android:textSize">18dp</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">left</item>
    </style>

    <style name="unitName">
        <item name="android:textSize">23dp</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="CustomProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_background</item>
        <item name="android:minHeight">13dp</item> <!-- Высота ProgressBar -->
    </style>

    <style name="CustomProgressBar2" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_background2</item>
        <item name="android:minHeight">13dp</item> <!-- Высота ProgressBar -->
    </style>

    <style name="VerticalProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">4dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:progressBackgroundTint">@android:color/darker_gray</item>
        <item name="android:progressTint">@color/primary</item>
        <item name="android:rotation">90</item>
        <item name="android:scaleY">-1</item> <!-- Flip to fill from bottom to top -->
    </style>


    <!-- Custom style for PopupMenu with white background -->
    <style name="PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <style name="menuBn">
        <item name="android:background">@android:color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/montserrat_medium</item>
<item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTheme"  parent="Widget.MaterialComponents.Toolbar.Primary">
        <!-- Цвет тулбара -->
        <item name="colorPrimary">@color/black</item>
        <!-- Цвет текста и иконок в тулбаре -->
        <item name="colorOnPrimary">@color/white</item>
    </style>
</resources>