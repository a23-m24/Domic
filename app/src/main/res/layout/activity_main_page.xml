<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainPageActivity">

    <!-- Основной контент -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_main">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/shape_nav_bar"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="1dp"
            tools:layout_editor_absoluteY="1dp">

            <ImageButton
                android:id="@+id/menu_bn"
                style="@style/nav_bar_bn"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_menu" />

            <Button
                android:id="@+id/textView"
                style="@style/h1"
                android:layout_weight="1"
                android:backgroundTint="@color/proz"
                android:text="DOMIC+" />

            <ImageButton
                android:id="@+id/imageButton3"
                style="@style/nav_bar_bn"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_widgets" />

            <ImageButton
                android:id="@+id/imageButton4"
                style="@style/nav_bar_bn"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_notyf" />

            <ImageButton
                android:id="@+id/imageButton5"
                style="@style/nav_bar_bn"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_account" />
        </LinearLayout>

        <TextView
            android:id="@+id/PageTitle"
            style="@style/h2"
            android:text="Главная"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

        <LinearLayout
            android:id="@+id/home_page"
            style="@style/pages"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/PageTitle"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:id="@+id/deadlines"
                style="@style/module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_module"
                android:visibility="gone">

                <TextView
                    style="@style/h3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ближайшие дедлайны">
                </TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Внимание! Указаны даты, начиная с которых будут действовать штрафы">
                </TextView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/courses"
                style="@style/module"
                android:background="@drawable/shape_module"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    style="@style/h3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Курсы">
                </TextView>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/courses_page"
            style="@style/pages"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="MissingConstraints"></LinearLayout>

        <LinearLayout
            android:id="@+id/dang_page"
            style="@style/pages"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="MissingConstraints">
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_page"
            style="@style/pages"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="MissingConstraints"></LinearLayout>

        <LinearLayout
            android:id="@+id/chat_page"
            style="@style/pages"
            android:orientation="vertical"
            android:visibility="gone"
            tools:ignore="MissingConstraints"></LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:elevation="16dp"
        app:menu="@menu/drawer_menu"
        app:theme="@style/NavigationViewStyle"/>
</androidx.drawerlayout.widget.DrawerLayout>